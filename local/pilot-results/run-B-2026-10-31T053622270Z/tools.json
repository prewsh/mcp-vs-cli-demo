{
  "tools": [
    {
      "name": "list_projects",
      "description": "List projects in the local deployment service.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "deploy_project",
      "description": "Start a new local deployment of an existing project. Returns a deployment ID and initial status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "project_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "get_deployment",
      "description": "Get the status and application URL of a deployment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deployment_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "deployment_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "get_runtime_logs",
      "description": "Read a bounded snapshot of runtime logs for a deployment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deployment_id": {
            "type": "string",
            "minLength": 1
          },
          "tail": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "deployment_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    }
  ]
}